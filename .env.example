DEBUG=True
SECRET_KEY=replace-this-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1,dynamic-job-portal-with-ai-and.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://dynamic-job-portal-with-ai-and-auto.vercel.app,https://dynamic-job-portal-with-ai-and.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://dynamic-job-portal-with-ai-and-auto.vercel.app
CORS_ALLOW_ALL_ORIGINS=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Set DATABASE_URL to your Render PostgreSQL internal URL in production.
DATABASE_URL=postgresql://user:password@host:port/database

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=JobPortal <your-email@gmail.com>
